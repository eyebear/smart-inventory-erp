# Runtime environment
SMART_INVENTORY_ENV=development
ANALYTICS_CONFIG=/opt/project/analytics/config/development.json
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_ID=smart_inventory_daily_analytics
AIRFLOW_EXPECTED_RUN_HOURS=30
AIRFLOW_BACKUP_TRIGGER_ENABLED=true
CRON_INTERVAL=*/15 * * * *

# Operational MySQL source
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307
MYSQL_DATABASE=smart_inventory_erp
MYSQL_USER=root
MYSQL_PASSWORD=abc123456

# Snowflake destination
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SMART_INVENTORY_ANALYTICS
SNOWFLAKE_ROLE=SYSADMIN

# Optional notifications and ThoughtSpot deployment
ALERT_WEBHOOK_URL=
THOUGHTSPOT_HOST=
THOUGHTSPOT_BEARER_TOKEN=
THOUGHTSPOT_CONNECTION_GUID=
